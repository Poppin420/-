# All values are server-only. In Netlify: Site configuration > Environment variables (mark secrets as secret).

# PostgreSQL. Netlify DB sets NETLIFY_DATABASE_URL automatically; DATABASE_URL takes precedence if set.
DATABASE_URL=

# Public origin of the app (Netlify also provides URL). Used for Origin checks and the Google OAuth redirect.
APP_BASE_URL=https://your-site.netlify.app

# Invite code required to create an account (at least 8 characters). Leave empty to close sign-ups.
SIGNUP_CODE=

# Groq: speech-to-text and intent extraction.
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts per-user secrets such as Google tokens.
DATA_ENCRYPTION_KEY=

# Optional Google Calendar integration (OAuth client of type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
