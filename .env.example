# Server-only secrets. Set these in Netlify: Site configuration > Environment variables (mark as secret).
GROQ_API_KEY=
# Temporary shared access token for the phase (a) preview, at least 16 characters.
APP_ACCESS_TOKEN=
# Optional: LLM model on Groq used for intent extraction.
GROQ_LLM_MODEL=llama-3.3-70b-versatile
